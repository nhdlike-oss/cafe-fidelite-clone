# Copiez ce fichier :  cp .env.example .env   (Windows : copy .env.example .env)
# puis remplacez les valeurs « CHANGEZ ». Le fichier .env n'est JAMAIS versionné.

# --- Application ---
# Clé secrète de Django. Générer une valeur aléatoire :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGEZ-moi-avec-une-cle-aleatoire

# Mode production : False. (Seulement True en développement, voir compose.dev.yaml.)
DEBUG=False

# Noms d'hôte acceptés, séparés par des virgules. Avec un vrai domaine : ajoutez-le ici.
ALLOWED_HOSTS=localhost,127.0.0.1

# Origines de confiance pour les formulaires (CSRF), séparées par des virgules.
# Avec un vrai domaine HTTPS : https://cafe.exemple.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Mettre True quand un proxy HTTPS sera devant l'application (cookies sécurisés).
USE_HTTPS=False

# Niveau des journaux : DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Base de données PostgreSQL ---
DB_NAME=cafe
DB_USER=cafe
DB_PASSWORD=CHANGEZ-moi
# `db` = le nom du service PostgreSQL dans compose.yaml. Ne pas changer pour Docker.
DB_HOST=db
DB_PORT=5432
